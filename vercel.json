{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo 'nothing to install: the build only needs Python 3 (Markdown is bundled in site/scripts/_vendor)'",
  "buildCommand": "python3 build.py",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "functions": {
    "api/contact.js": { "maxDuration": 10 }
  },
  "redirects": [
    { "source": "/work/finpay", "destination": "/work/", "permanent": true },
    { "source": "/work/finpay/:path*", "destination": "/work/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    },
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/uploads/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }] },
    {
      "source": "/admin/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ]
}
